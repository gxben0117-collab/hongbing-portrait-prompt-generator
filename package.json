{
  "name": "hongbing-portrait-prompt-generator",
  "private": true,
  "version": "1.0.0",
  "description": "Hongbing portrait prompt generator engineering workspace",
  "scripts": {
    "build": "npm run build:dist",
    "lint": "npm run lint:prompt-governance && npm run audit:style-examples && npm run audit:identity-contamination && npm run audit:style-index && npm run report:risk-flags",
    "test": "npm run verify:identity-engine && npm run verify:ui-static && npm run verify:headless-browser",
    "check:structure": "python scripts/check_structure.py",
    "build:dist": "python scripts/build_dist.py",
    "report:data-gaps": "python scripts/report_data_gaps.py",
    "phase0:freeze-style-index": "node scripts/freeze_style_index_phase0.mjs",
    "audit:style-examples": "node scripts/audit_style_examples.mjs",
    "audit:identity-contamination": "node scripts/audit_identity_contamination.mjs",
    "audit:style-examples-baseline": "node scripts/audit_style_examples_baseline.mjs",
    "clean:style-examples": "node scripts/clean_style_examples.mjs",
    "build:style-index-draft": "node scripts/build_style_index_draft.mjs",
    "audit:style-index": "node scripts/audit_style_index.mjs",
    "build:style-data": "node scripts/build_style_data.mjs",
    "sync:style-data": "node scripts/build_style_data.mjs --write-html",
    "verify:ui-static": "node scripts/verify_ui_static.mjs",
    "verify:identity-engine": "node scripts/verify_identity_engine.mjs",
    "verify:headless-browser": "node scripts/verify_headless_browser.mjs",
    "report:risk-flags": "node scripts/report_risk_flags.mjs",
    "lint:prompt-governance": "node scripts/lint_prompt_governance.mjs",
    "fill:style-pose-fields": "node scripts/fill_style_pose_fields.mjs",
    "fill:style-camera-design": "node scripts/fill_style_camera_design.mjs",
    "fill:markdown-camera-fields": "node scripts/fill_markdown_camera_fields.mjs",
    "sanitize:style-source-terms": "node scripts/sanitize_style_source_terms.mjs",
    "reverse:prompts-to-style-md": "node scripts/reverse_prompts_to_style_md.mjs",
    "sync:reverse-samples": "node scripts/sync_reverse_samples_to_runtime.mjs",
    "append:v027-backup": "node scripts/append_v027_backup_to_style_md.mjs",
    "sync:v027-backup": "node scripts/sync_v027_backup_to_runtime.mjs"
  }
}
